{
  "name": "raw-device-events-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "device.raw.v1",
    "connection.url": "jdbc:postgresql://postgres:5432/aetus",
    "connection.user": "aetus",
    "connection.password": "aetus",
    "auto.create": "false",
    "insert.mode": "upsert",
    "pk.mode": "record_value",
    "pk.fields": "device_id,boot_id,sequence",
    "table.name.format": "raw_device_events",
    "delete.enabled": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true"
  }
}
