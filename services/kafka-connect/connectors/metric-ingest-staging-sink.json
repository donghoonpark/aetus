{
  "name": "metric-ingest-staging-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "device.metric.v1",
    "connection.url": "${PG_CONNECTION_URL}",
    "connection.user": "${PG_CONNECTION_USER}",
    "connection.password": "${PG_CONNECTION_PASSWORD}",
    "auto.create": "false",
    "insert.mode": "upsert",
    "pk.mode": "record_value",
    "pk.fields": "request_id,metric_index",
    "table.name.format": "metric_ingest_staging",
    "delete.enabled": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true"
  }
}
