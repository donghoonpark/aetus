menu "AETUS upload stack"

config AETUS_MAX_METRICS
    int "Maximum metrics per telemetry event"
    default 32
    range 4 32
    help
        Maximum number of Metric entries accepted in one telemetry event.
        The first four entries are stored inline in aetus_telemetry_t; entries
        after that are allocated on the FreeRTOS heap. The upper bound remains
        compile-time limited because nanopb uses a fixed repeated-field array
        while encoding.

config AETUS_SIGNAL_SAMPLES_MAX
    int "Maximum signal frame sample bytes"
    default 2400
    range 1 8192
    help
        Maximum raw sample bytes accepted in one signal frame. Samples are
        borrowed by aetus_signal_frame_t and copied into a heap-allocated
        buffer when enqueued.

config AETUS_ENCODE_BUFFER_BYTES
    int "AETUS protobuf encode buffer bytes"
    default 4096
    range 1024 16384
    help
        Stack buffer used by the uploader task to hold one encoded protobuf
        request body. It must be larger than AETUS_SIGNAL_SAMPLES_MAX plus
        protobuf envelope and channel metadata overhead.

config AETUS_TASK_STACK_BYTES
    int "AETUS uploader task stack bytes"
    default 12288
    range 8192 24576
    help
        Stack size for the uploader task. The task owns the encode buffer and
        one queue item while posting to HTTP.

config AETUS_QUEUE_ITEM_MAX_BYTES
    int "Maximum AETUS queue item bytes"
    default 1024
    range 512 4096
    help
        Compile-time guard for the size of one FreeRTOS queue item. Signal
        frame sample bytes are held by the sample pool, so queue slots should
        stay small even when AETUS_SIGNAL_SAMPLES_MAX grows.

config AETUS_ISR_SAFE_ENQUEUE
    bool "ISR-safe telemetry and status enqueue"
    default y
    help
        Enable aetus_enqueue_telemetry_from_isr() and
        aetus_enqueue_status_from_isr(). When enabled, a global buffer
        (sizeof(aetus_queue_item_t) bytes in BSS) is reserved so the
        enqueue path never allocates the item on the calling task's stack,
        making it safe to call from an interrupt even when interrupting
        a small-stack task such as the IDLE task.

        Disable this option to reclaim the global buffer when the ISR-safe
        API is not used.

config AETUS_TEST_HOOKS
    bool "AETUS internal test hooks"
    default n
    help
        Expose internal ownership helpers for ESP-IDF/QEMU contract tests.
        Keep this disabled in production firmware.

config AETUS_TEST_NO_NETWORK
    bool "AETUS test build without WiFi/HTTP backends"
    default n
    depends on AETUS_TEST_HOOKS
    help
        Build the uploader runtime against test hooks only, without linking the
        ESP WiFi/PHY/HTTP backend. This keeps QEMU ownership tests focused on
        queue, encode, and release behavior while avoiding unsupported radio
        startup paths in emulation.

endmenu
