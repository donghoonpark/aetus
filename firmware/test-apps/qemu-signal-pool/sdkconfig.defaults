CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Keep this app tiny and deterministic: queue_depth=1 lets us verify
# queue-send-failure release without waiting for Wi-Fi or HTTP. This app
# compiles only the signal sample pool source directly, so AETUS Kconfig
# symbols are intentionally not used here.
